# Per-operator settings for the console. `bin/console up` writes .env from your git identity on first start;
# this file lists the settings you can add. Never commit .env.
RDSC_OPERATOR_NAME=
RDSC_GIT_AUTHOR_NAME=
RDSC_GIT_AUTHOR_EMAIL=
# Leave unset to use the bundled Postgres container, or point at a shared control database:
# RDSC_CONTROL_DATABASE_URL=postgresql+psycopg://user:password@host:5432/rdscommander
# Where the console keeps its configuration and Terraform: a git repository. Created on first start.
# RDSC_HOME_DIR=./home
RDSC_HTTP_PORT=8470
RDSC_TERRAFORM_BINARY=tofu
# Names this console in the runner identity instead of the container hostname (compose fixes that one):
# RDSC_RUNNER_IDENTITY_NAME=
