#!/usr/bin/env bash
# Operator entry point: `bin/console up|down|logs`. Run from anywhere.
set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${RDSC_ENV_FILE:-${APP_DIR}/.env}"
# The operator's .env feeds both the backend container (env_file) and compose interpolation (--env-file),
# so a shared control database URL, a custom port or a home location set there reaches compose too.
COMPOSE=(docker compose --project-directory "${APP_DIR}" -f "${APP_DIR}/compose.yaml" --env-file "${ENV_FILE}")

log() { printf '{"event":"%s","detail":"%s"}\n' "$1" "${2:-}"; }

env_value() {
  # The value of KEY from the environment, else from the operator's .env, else empty.
  local key="$1"
  if [ -n "${!key:-}" ]; then printf '%s' "${!key}"; return; fi
  grep -E "^${key}=" "${ENV_FILE}" 2>/dev/null | tail -n 1 | cut -d= -f2- || true
}

home_dir() {
  # Where the console keeps its configuration (config/) and the Terraform it maintains (terraform/).
  local configured
  configured="$(env_value RDSC_HOME_DIR)"
  printf '%s' "${configured:-${APP_DIR}/home}"
}

write_env_file() {
  if [ -f "${ENV_FILE}" ]; then return; fi
  local name email
  name="$(git config user.name || echo "Console Operator")"
  email="$(git config user.email || echo "operator@localhost")"
  cat > "${ENV_FILE}" <<EOF_ENV
# Per-operator settings for the console. Not committed.
RDSC_OPERATOR_NAME=${name}
RDSC_GIT_AUTHOR_NAME=${name}
RDSC_GIT_AUTHOR_EMAIL=${email}
# Set this to use a shared control database instead of the bundled one:
# RDSC_CONTROL_DATABASE_URL=postgresql+psycopg://user:password@host:5432/rdscommander
# Where the console keeps its configuration and Terraform: a git repository. Created on first start.
# RDSC_HOME_DIR=${APP_DIR}/home
RDSC_HTTP_PORT=8470
RDSC_TERRAFORM_BINARY=tofu
EOF_ENV
  log "env_file_written" "${ENV_FILE}"
}

ensure_bundled_database_password() {
  # The bundled control database's password lives only in the operator's .env. A new .env gets a random
  # one. An .env written before this existed keeps working: if the database volume already exists it was
  # initialised with the old fixed password, so that password is recorded instead of a new one.
  if grep -Eq '^RDSC_BUNDLED_DATABASE_PASSWORD=.+' "${ENV_FILE}" 2>/dev/null; then return; fi
  local password
  if docker volume inspect rdscommander_control-db-data >/dev/null 2>&1; then
    password="rdscommander" # ggignore - the password an existing database volume was created with
    log "bundled_database_password_kept" "existing volume keeps its original password; rotate it with ALTER USER"
  else
    password="$(openssl rand -hex 24)"
    log "bundled_database_password_generated" "${ENV_FILE}"
  fi
  printf 'RDSC_BUNDLED_DATABASE_PASSWORD=%s\n' "${password}" >> "${ENV_FILE}"
}

ensure_home() {
  # First start: create the home as a git repository holding the example configuration. Its upstream is
  # a bare repository inside it, addressed by a relative URL so git can reach it on this machine and inside
  # the console container, which lets the console check that its checkout is current. To keep the
  # configuration and Terraform in an existing repository instead, point RDSC_HOME_DIR at it.
  local home name email
  home="$(home_dir)"
  name="$(git config user.name || echo "Console Operator")"
  email="$(git config user.email || echo "operator@localhost")"
  if [ ! -d "${home}/.git" ]; then
    mkdir -p "${home}"
    git init -q -b main "${home}"
    git init -q --bare -b main "${home}/.origin.git"
    cp -R "${APP_DIR}/config.example" "${home}/config"
    printf '.origin.git/\nterraform/**/.terraform/\nterraform/**/*.tfplan\n' > "${home}/.gitignore"
    (
      cd "${home}"
      git remote add origin ./.origin.git
      git add -A
      git -c user.name="${name}" -c user.email="${email}" commit -q -m "Add console configuration"
      git push -q -u origin main
    )
    log "home_created" "${home}"
  elif [ ! -d "${home}/config" ]; then
    cp -R "${APP_DIR}/config.example" "${home}/config"
    log "home_configuration_added" "${home}/config was copied from config.example; review it and commit it"
  fi
}

ensure_mount_sources() {
  # Bind-mount sources must exist, otherwise Docker creates directories in their place.
  mkdir -p "${HOME}/.aws" "${HOME}/.ssh"
  [ -f "${HOME}/.gitconfig" ] || touch "${HOME}/.gitconfig"
  if [ ! -f "${HOME}/.git-credentials" ]; then
    (umask 077 && touch "${HOME}/.git-credentials")
  fi
  # SSH agent forwarding: Docker Desktop exposes the host agent at a fixed path; on Linux use the socket itself.
  case "$(uname -s)" in
    Darwin) export RDSC_SSH_AUTH_SOCK="${RDSC_SSH_AUTH_SOCK:-/run/host-services/ssh-auth.sock}" ;;
    *) export RDSC_SSH_AUTH_SOCK="${RDSC_SSH_AUTH_SOCK:-${SSH_AUTH_SOCK:-/dev/null}}" ;;
  esac
}

compose_profiles() {
  if ! grep -Eq '^RDSC_CONTROL_DATABASE_URL=.+' "${ENV_FILE}" 2>/dev/null; then echo "--profile"; echo "bundled-db"; fi
  if grep -Eq '^\s*simulated:\s*true' "$(home_dir)/config/environments.yaml" 2>/dev/null; then echo "--profile"; echo "simulated-aws"; fi
}

read_profiles() {
  PROFILES=()
  while IFS= read -r line; do [ -n "${line}" ] && PROFILES+=("${line}"); done < <(compose_profiles)
}

http_port() {
  grep -E '^RDSC_HTTP_PORT=' "${ENV_FILE}" 2>/dev/null | cut -d= -f2 || true
}

case "${1:-}" in
  up)
    write_env_file
    ensure_bundled_database_password
    ensure_home
    ensure_mount_sources
    read_profiles
    log "console_starting" "profiles=${PROFILES[*]:-none}"
    RDSC_ENV_FILE="${ENV_FILE}" RDSC_HOME_DIR="$(home_dir)" "${COMPOSE[@]}" ${PROFILES[@]+"${PROFILES[@]}"} up --build -d
    log "console_ready" "http://127.0.0.1:$(http_port)"
    ;;
  down)
    RDSC_ENV_FILE="${ENV_FILE}" RDSC_HOME_DIR="$(home_dir)" "${COMPOSE[@]}" --profile bundled-db --profile simulated-aws down
    ;;
  logs)
    RDSC_ENV_FILE="${ENV_FILE}" RDSC_HOME_DIR="$(home_dir)" "${COMPOSE[@]}" --profile bundled-db --profile simulated-aws logs -f backend
    ;;
  profiles)
    compose_profiles
    ;;
  *)
    echo "usage: console up|down|logs|profiles" >&2
    exit 2
    ;;
esac
