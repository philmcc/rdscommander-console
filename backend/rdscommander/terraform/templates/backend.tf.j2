terraform {
  backend "s3" {
    bucket       = {{ state_bucket_name | hcl }}
    key          = {{ state_key | hcl }}
    region       = {{ aws_region | hcl }}
    use_lockfile = true
    encrypt      = true
{% if simulated %}
    access_key                  = "testing"
    secret_key                  = "testing"
    skip_credentials_validation = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    skip_region_validation      = true
    skip_s3_checksum            = true
    use_path_style              = true
    endpoints = {
      s3 = {{ simulated_endpoint_url | hcl }}
    }
{% else %}
    profile = {{ aws_profile_name | hcl }}
{% endif %}
  }
}
