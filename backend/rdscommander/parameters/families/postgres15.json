{
  "family": "postgres15",
  "engine": "postgres",
  "engine_versions": [{"engine_version": "15.8", "valid_upgrade_targets": [{"engine_version": "15.10", "is_major": false}, {"engine_version": "16.6", "is_major": true}]}],
  "parameters": [
    {"ParameterName": "shared_buffers", "ParameterValue": "{DBInstanceClassMemory/32768}", "Description": "Sets the number of shared memory buffers used by the server.", "DataType": "integer", "AllowedValues": "16-1073741823", "IsModifiable": true, "ApplyType": "static"},
    {"ParameterName": "work_mem", "ParameterValue": "4096", "Description": "Sets the maximum memory to be used for query workspaces.", "DataType": "integer", "AllowedValues": "64-2147483647", "IsModifiable": true, "ApplyType": "dynamic"},
    {"ParameterName": "maintenance_work_mem", "ParameterValue": "GREATEST({DBInstanceClassMemory/63963136*1024},65536)", "Description": "Sets the maximum memory to be used for maintenance operations.", "DataType": "integer", "AllowedValues": "1024-2147483647", "IsModifiable": true, "ApplyType": "dynamic"},
    {"ParameterName": "log_min_duration_statement", "ParameterValue": "-1", "Description": "Sets the minimum execution time above which statements will be logged.", "DataType": "integer", "AllowedValues": "-1-2147483647", "IsModifiable": true, "ApplyType": "dynamic"},
    {"ParameterName": "log_statement", "ParameterValue": "none", "Description": "Sets the type of statements logged.", "DataType": "string", "AllowedValues": "none,ddl,mod,all", "IsModifiable": true, "ApplyType": "dynamic"},
    {"ParameterName": "max_connections", "ParameterValue": "LEAST({DBInstanceClassMemory/9531392},5000)", "Description": "Sets the maximum number of concurrent connections.", "DataType": "integer", "AllowedValues": "6-8388607", "IsModifiable": true, "ApplyType": "static"},
    {"ParameterName": "random_page_cost", "ParameterValue": "4", "Description": "Sets the planner's estimate of the cost of a nonsequentially fetched disk page.", "DataType": "float", "AllowedValues": "0-1.79769e+308", "IsModifiable": true, "ApplyType": "dynamic"},
    {"ParameterName": "rds.force_ssl", "ParameterValue": "1", "Description": "Force SSL connections.", "DataType": "boolean", "AllowedValues": "0,1", "IsModifiable": true, "ApplyType": "dynamic"},
    {"ParameterName": "rds.logical_replication", "ParameterValue": "0", "Description": "Enables logical decoding.", "DataType": "boolean", "AllowedValues": "0,1", "IsModifiable": true, "ApplyType": "static"},
    {"ParameterName": "autovacuum_vacuum_scale_factor", "ParameterValue": "0.1", "Description": "Number of tuple updates or deletes prior to vacuum as a fraction of reltuples.", "DataType": "float", "AllowedValues": "0-100", "IsModifiable": true, "ApplyType": "dynamic"},
    {"ParameterName": "force_parallel_mode", "ParameterValue": "off", "Description": "Forces the planner's use of parallel query facilities.", "DataType": "string", "AllowedValues": "off,on,regress", "IsModifiable": true, "ApplyType": "dynamic"},
    {"ParameterName": "old_snapshot_threshold", "ParameterValue": "-1", "Description": "Time before a snapshot is too old to read pages changed after the snapshot was taken.", "DataType": "integer", "AllowedValues": "-1-86400", "IsModifiable": true, "ApplyType": "static"},
    {"ParameterName": "wal_compression", "ParameterValue": "off", "Description": "Compresses full-page writes written in WAL file.", "DataType": "string", "AllowedValues": "on,off,pglz,lz4,zstd", "IsModifiable": true, "ApplyType": "dynamic"},
    {"ParameterName": "rds.rds_superuser_reserved_connections", "ParameterValue": "2", "Description": "Connections reserved for rds_superuser.", "DataType": "integer", "AllowedValues": "0-8388607", "IsModifiable": false, "ApplyType": "static"},
    {"ParameterName": "vacuum_defer_cleanup_age", "ParameterValue": "0", "Description": "Number of transactions by which VACUUM and HOT cleanup should be deferred, if any.", "DataType": "integer", "AllowedValues": "0-1000000", "IsModifiable": true, "ApplyType": "dynamic"}
  ]
}
